<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="ir.negahban.saken"
    android:versionCode="19"
    android:versionName="1.4.10">

    <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="34"/>

    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>

    <application
        android:icon="@mipmap/ic_launcher"
        android:label="ساکن‌یار"
        android:supportsRtl="true"
        android:allowBackup="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <activity android:name=".GateActivity" android:exported="false"/>
        <activity android:name=".PackagesActivity" android:exported="false"/>
        <activity android:name=".RoofKeyActivity" android:exported="false"/>
        <activity android:name=".ServiceRequestActivity" android:exported="false"/>
        <activity android:name=".SettingsActivity" android:exported="false"/>
        <activity android:name=".GuestRequestActivity" android:exported="false"/>
        <activity android:name=".NotificationsActivity" android:exported="false"/>
        <service android:name=".NotifyService" android:exported="false" android:foregroundServiceType="dataSync"/>
        <activity android:name=".ChargeActivity" android:exported="false"/>
        <activity android:name=".ForceUpdateActivity" android:exported="false"/>

        <provider android:name=".ApkProvider" android:authorities="ir.negahban.saken.apk"
            android:exported="false" android:grantUriPermissions="true"/>
    </application>
</manifest>
